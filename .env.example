# Names only. For local Workers development, put values in ignored .dev.vars.
# For Sites hosting, set these as production secrets and redeploy.
# Model IDs are chosen per bot in Team settings (default Grok model: grok-4.7), not via env.
RULI_OWNER_EMAIL=
XAI_API_KEY=
OPENAI_API_KEY=

# Исходящий вебхук для агентов Grok Bot (значения задайте в .dev.vars или секретах Sites).
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=
GROK_BOT_WEBHOOK_HEADER=

# Входящий HTTP API ботов и публичный адрес приложения.
RULI_BOT_API_TOKEN=
RULI_BASE_URL=
